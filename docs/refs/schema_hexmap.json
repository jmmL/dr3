{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/refs/schema_hexmap.json",
  "description": "Compact hexmap schema. Keys: c=col, r=row, t=terrain, n=name, k=kingdom, i=intrinsic, cid=cityId",
  "type": "object",
  "required": ["version", "exportDate", "map"],
  "properties": {
    "version": {"type": "string"},
    "exportDate": {"type": "string"},
    "map": {
      "type": "object",
      "required": ["cols", "rows", "hexes"],
      "properties": {
        "cols": {"type": "integer"},
        "rows": {"type": "integer"},
        "hexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["c", "r"],
            "properties": {
              "c": {"type": "integer", "description": "column"},
              "r": {"type": "integer", "description": "row"},
              "t": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}], "description": "terrain type(s)"},
              "n": {"type": "string", "description": "name"},
              "k": {"type": "string", "description": "kingdom/factionId"},
              "i": {"type": "integer", "description": "intrinsic defense"},
              "cid": {"type": "string", "description": "cityId"}
            }
          }
        }
      }
    }
  }
}
