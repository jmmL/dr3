{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/refs/schema_abilities.json",
  "description": "Compact abilities schema. Keys: v=version, a=abilities, id=abilityId, n=name, refs=ruleRefs",
  "type": "object",
  "required": ["v", "a"],
  "properties": {
    "v": {"type": "string", "description": "version"},
    "a": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "n"],
        "properties": {
          "id": {"type": "string", "description": "abilityId"},
          "n": {"type": "string", "description": "name"},
          "refs": {"type": "array", "items": {"type": "string"}, "description": "ruleRefs"}
        }
      }
    }
  }
}
