{
  "suite_version": "1.0.0",
  "rule_section": "28_death_and_capture",
  "tests": [
    {
      "id": "28.1.1_non_player_death_confusion",
      "rule_ref": "28.1.1",
      "description": "Non-player monarch death causes kingdom to enter confusion",
      "input": {
        "monarch_type": "non_player",
        "monarch_killed": true
      },
      "expected": {
        "kingdom_status": "confusion"
      }
    },
    {
      "id": "28.1.2_confusion_duration_roll",
      "rule_ref": "28.1.2",
      "description": "Confusion duration is 1d6 turns",
      "input": {
        "confusion_duration_roll": 4
      },
      "expected": {
        "confusion_turns": 4
      }
    },
    {
      "id": "28.1.3_regulars_defend_during_confusion",
      "rule_ref": "28.1.3",
      "description": "During confusion, regulars defend normally but cannot move/siege/initiate combat",
      "input": {
        "kingdom_status": "confusion",
        "action": "defend"
      },
      "expected": {
        "defend_allowed": true,
        "move_allowed": false,
        "siege_allowed": false,
        "initiate_combat_allowed": false
      }
    },
    {
      "id": "28.1.3_confusion_units_removed_at_turn_end",
      "rule_ref": "28.1.3",
      "description": "At end of current player turn, all units removed and placed on identity card",
      "input": {
        "confusion_triggered": true,
        "current_phase": "end_of_turn"
      },
      "expected": {
        "units_removed_from_map": true,
        "units_placed_on": "identity_card"
      }
    },
    {
      "id": "28.1.3_monarch_counter_on_time_track",
      "rule_ref": "28.1.3",
      "description": "Monarch counter placed on Time Record Track for availability turn",
      "input": {
        "confusion_duration": 4,
        "current_turn": 5
      },
      "expected": {
        "monarch_available_turn": 9
      }
    },
    {
      "id": "28.1.3_no_diplomacy_during_confusion",
      "rule_ref": "28.1.3",
      "description": "No ambassador may work in kingdom during confusion",
      "input": {
        "kingdom_status": "confusion",
        "diplomacy_attempt": true
      },
      "expected": {
        "diplomacy_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "28.1.4_new_personality_at_confusion_end",
      "rule_ref": "28.1.4",
      "description": "At end of confusion, new personality card drawn for new monarch",
      "input": {
        "confusion_ends": true
      },
      "expected": {
        "new_personality_card": true,
        "card_placement": "face_down_under_identity"
      }
    },
    {
      "id": "28.1.4_old_personality_discarded",
      "rule_ref": "28.1.4",
      "description": "Old personality card discarded when confusion ends",
      "input": {
        "confusion_ends": true,
        "old_personality_card": "some_card"
      },
      "expected": {
        "old_card_discarded": true
      }
    },
    {
      "id": "28.1.5_border_violation_during_confusion",
      "rule_ref": "28.1.5",
      "description": "Border violation during confusion incurs penalty and crowns new monarch immediately",
      "input": {
        "kingdom_status": "confusion",
        "border_violated": true
      },
      "expected": {
        "diplomatic_penalty_incurred": true,
        "new_monarch_crowned_immediately": true,
        "kingdom_available_immediately": true
      }
    },
    {
      "id": "28.1.6_eliminated_regulars_remain",
      "rule_ref": "28.1.6",
      "description": "Eliminated regulars remain eliminated; only replaced via Random Events",
      "input": {
        "regulars_eliminated_before_confusion": 3,
        "confusion_ends": true
      },
      "expected": {
        "regulars_still_eliminated": 3,
        "automatic_replacement": false
      }
    },
    {
      "id": "28.2.1_player_monarch_death_elimination",
      "rule_ref": "28.2.1",
      "description": "Player monarch death or capture eliminates player from game",
      "input": {
        "monarch_type": "player",
        "monarch_killed": true
      },
      "expected": {
        "player_eliminated": true
      }
    },
    {
      "id": "28.2.2_all_allies_deactivate",
      "rule_ref": "28.2.2",
      "description": "When player eliminated, all allied kingdoms deactivate",
      "input": {
        "player_eliminated": true,
        "allied_kingdoms": ["neuth", "ghem"]
      },
      "expected": {
        "kingdoms_deactivated": ["neuth", "ghem"]
      }
    },
    {
      "id": "28.2.3_player_kingdom_enters_confusion",
      "rule_ref": "28.2.3",
      "description": "Player's home kingdom enters confusion",
      "input": {
        "player_eliminated": true,
        "player_kingdom": "hothior"
      },
      "expected": {
        "kingdom_status": "confusion"
      }
    },
    {
      "id": "28.2.4_after_confusion_becomes_non_player",
      "rule_ref": "28.2.4",
      "description": "After confusion, kingdom available for diplomacy as non-player kingdom",
      "input": {
        "player_eliminated": true,
        "confusion_ends": true
      },
      "expected": {
        "personality_card_drawn": true,
        "kingdom_available_for_diplomacy": true
      }
    },
    {
      "id": "28.2.5_player_keeps_victory_points",
      "rule_ref": "28.2.5",
      "description": "Eliminated player keeps previously earned victory points",
      "input": {
        "player_eliminated": true,
        "victory_points_earned": 50
      },
      "expected": {
        "victory_points_retained": 50
      }
    },
    {
      "id": "28.2.6_posthumous_victory_possible",
      "rule_ref": "28.2.6",
      "description": "Eliminated player can win if they have highest points at game end",
      "input": {
        "player_eliminated": true,
        "player_points": 100,
        "other_player_highest": 80
      },
      "expected": {
        "player_can_win": true
      }
    },
    {
      "id": "28.2.7_reentry_option",
      "rule_ref": "28.2.7",
      "description": "Eliminated player may re-enter next turn by forfeiting all points",
      "input": {
        "player_eliminated": true,
        "turns_since_elimination": 1,
        "victory_points": 50
      },
      "expected": {
        "reentry_allowed": true,
        "victory_points_forfeited": 50,
        "requires_approval": true
      }
    },
    {
      "id": "28.2.7_reentry_random_kingdom",
      "rule_ref": "28.2.7",
      "description": "Re-entry kingdom selected randomly from available non-player kingdoms",
      "input": {
        "reentry_approved": true,
        "available_kingdoms": ["neuth", "zorn"],
        "kingdoms_in_confusion": ["ghem"]
      },
      "expected": {
        "valid_kingdoms": ["neuth", "zorn"],
        "selection_method": "random"
      }
    },
    {
      "id": "28.3.1_prisoner_placement_nearest_castle",
      "rule_ref": "28.3.1",
      "description": "Captured monarch placed in nearest unbesieged castle controlled by captor",
      "input": {
        "monarch_captured": true,
        "captor_castles": [[10, 5], [20, 10]],
        "capture_location": [12, 6]
      },
      "expected": {
        "prison_location": [10, 5],
        "selection_criteria": "nearest_unbesieged"
      }
    },
    {
      "id": "28.3.2_no_castle_execute_or_free",
      "rule_ref": "28.3.2",
      "description": "If captor has no castle, must execute or set prisoner free",
      "input": {
        "monarch_captured": true,
        "captor_castles": []
      },
      "expected": {
        "options": ["execute_immediately", "set_free"]
      }
    },
    {
      "id": "28.3.3_capture_awards_points",
      "rule_ref": "28.3.3",
      "description": "Victory points awarded for capture regardless of subsequent actions",
      "input": {
        "monarch_captured": true,
        "monarch_type": "non_player"
      },
      "expected": {
        "victory_points_awarded": 30
      }
    },
    {
      "id": "28.3.4_prisoner_no_transfer",
      "rule_ref": "28.3.4",
      "description": "Prisoner cannot be transferred to another player",
      "input": {
        "prisoner_in_castle": true,
        "transfer_attempt": true
      },
      "expected": {
        "transfer_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "28.3.4_prisoner_no_action",
      "rule_ref": "28.3.4",
      "description": "Prisoner incapable of offensive or defensive action",
      "input": {
        "monarch_status": "prisoner"
      },
      "expected": {
        "offensive_action_allowed": false,
        "defensive_action_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "28.3.4_intrinsic_defense_serves_as_garrison",
      "rule_ref": "28.3.4",
      "description": "Castle intrinsic defense serves as garrison for prisoner",
      "input": {
        "prisoner_in_castle": true,
        "intrinsic_defense": 4
      },
      "expected": {
        "garrison_strength": 4
      }
    },
    {
      "id": "28.3.5_release_by_siege",
      "rule_ref": "28.3.5",
      "description": "Prisoner released if prison castle taken by prisoner's own or allied troops",
      "input": {
        "prison_castle_sieged": true,
        "siege_successful": true,
        "besieging_forces": "prisoner_allies"
      },
      "expected": {
        "prisoner_released": true
      }
    },
    {
      "id": "28.3.5_release_by_deactivation",
      "rule_ref": "28.3.5",
      "description": "Prisoner released if captor's kingdom deactivates",
      "input": {
        "captor_kingdom_deactivated": true
      },
      "expected": {
        "prisoner_released": true
      }
    },
    {
      "id": "28.3.6_release_placement",
      "rule_ref": "28.3.6",
      "description": "Released prisoner placed at nearest unplundered, unbesieged friendly castle",
      "input": {
        "prisoner_released": true,
        "friendly_castles": [[15, 8], [25, 12]],
        "release_location": [10, 5]
      },
      "expected": {
        "placement_location": [15, 8],
        "selection_criteria": "nearest_unplundered_unbesieged_friendly"
      }
    },
    {
      "id": "28.4.1_execution_timing",
      "rule_ref": "28.4.1",
      "description": "Prisoner may be executed immediately upon capture or any diplomacy phase",
      "input": {
        "prisoner_held": true,
        "current_phase": "diplomacy"
      },
      "expected": {
        "execution_allowed": true
      }
    },
    {
      "id": "28.4.2_execution_no_victory_points",
      "rule_ref": "28.4.2",
      "description": "Execution awards no victory points (capture points already awarded)",
      "input": {
        "prisoner_executed": true
      },
      "expected": {
        "additional_victory_points": 0
      }
    },
    {
      "id": "28.4.3_execution_permanent_penalty",
      "rule_ref": "28.4.3",
      "description": "Execution incurs permanent diplomatic penalty in slain monarch's kingdom",
      "input": {
        "prisoner_executed": true,
        "prisoner_kingdom": "neuth"
      },
      "expected": {
        "diplomatic_penalty_kingdom": "neuth",
        "penalty_duration": "permanent"
      }
    },
    {
      "id": "28.5.1_forcing_peace_timing",
      "rule_ref": "28.5.1",
      "description": "Forced peace attempt on prisoner possible each turn during jailer's diplomacy phase",
      "input": {
        "prisoner_held": true,
        "current_phase": "diplomacy"
      },
      "expected": {
        "forced_peace_attempt_allowed": true
      }
    },
    {
      "id": "28.5.2_in_addition_to_normal_diplomacy",
      "rule_ref": "28.5.2",
      "description": "Forced peace on prisoner is in addition to normal diplomacy elsewhere",
      "input": {
        "forced_peace_on_prisoner": true,
        "normal_diplomacy_elsewhere": true
      },
      "expected": {
        "both_actions_allowed": true
      }
    },
    {
      "id": "28.5.3_forced_peace_success_roll",
      "rule_ref": "28.5.3",
      "description": "Forced peace on prisoner succeeds on roll of 5 or 6",
      "input": {
        "forced_peace_roll": 5,
        "prisoner_forces_besieging": false
      },
      "expected": {
        "forced_peace_success": true
      }
    },
    {
      "id": "28.5.4_besieged_prison_only_six",
      "rule_ref": "28.5.4",
      "description": "If prison besieged by prisoner's forces, only 6 succeeds",
      "input": {
        "forced_peace_roll": 5,
        "prisoner_forces_besieging": true
      },
      "expected": {
        "forced_peace_success": false
      }
    },
    {
      "id": "28.5.5_no_modifiers_on_prisoner_peace",
      "rule_ref": "28.5.5",
      "description": "Diplomacy cards and penalties do not apply to forced peace on prisoner",
      "input": {
        "forced_peace_roll": 4,
        "diplomacy_card_modifier": 2
      },
      "expected": {
        "modified_roll": 4,
        "modifiers_applied": false
      },
      "tags": ["negative"]
    },
    {
      "id": "28.5.7_occupied_royal_castle_only_jailer",
      "rule_ref": "28.5.7",
      "description": "If royal castle occupied, only jailer may make forced peace roll",
      "input": {
        "royal_castle_occupied": true,
        "attempting_player": "other_player"
      },
      "expected": {
        "forced_peace_allowed": false
      },
      "tags": ["negative"]
    }
  ]
}
