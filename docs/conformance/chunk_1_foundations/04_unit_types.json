{
  "suite_version": "1.0.0",
  "rule_section": "4_unit_types",
  "tests": [
    {
      "id": "4.1.2_monarch_not_combat_unit",
      "rule_ref": "4.1.2",
      "description": "Monarch is not a combat unit",
      "input": {
        "unit_type": "monarch"
      },
      "expected": {
        "is_combat_unit": false
      }
    },
    {
      "id": "4.1.3_monarch_is_leader",
      "rule_ref": "4.1.3",
      "description": "Monarch is a leader unit",
      "input": {
        "unit_type": "monarch"
      },
      "expected": {
        "is_leader": true
      }
    },
    {
      "id": "4.1.5_player_monarch_death_eliminates",
      "rule_ref": "4.1.5",
      "description": "Player monarch death eliminates player from game",
      "input": {
        "unit_type": "monarch",
        "monarch_type": "player",
        "event": "death"
      },
      "expected": {
        "player_eliminated": true
      }
    },
    {
      "id": "4.1.6_non_player_monarch_death_confusion",
      "rule_ref": "4.1.6",
      "description": "Non-player monarch death causes kingdom to enter confusion",
      "input": {
        "unit_type": "monarch",
        "monarch_type": "non_player",
        "event": "death"
      },
      "expected": {
        "kingdom_enters_confusion": true
      }
    },
    {
      "id": "4.2.2_ambassador_not_combat_unit",
      "rule_ref": "4.2.2",
      "description": "Ambassador is not a combat unit",
      "input": {
        "unit_type": "ambassador"
      },
      "expected": {
        "is_combat_unit": false
      }
    },
    {
      "id": "4.2.3_ambassador_teleports",
      "rule_ref": "4.2.3",
      "description": "Ambassador teleports to diplomatic function location",
      "input": {
        "unit_type": "ambassador"
      },
      "expected": {
        "movement_type": "teleport"
      }
    },
    {
      "id": "4.2.4_ambassador_death_recovery",
      "rule_ref": "4.2.4",
      "description": "Ambassador recovers 2 turns after death",
      "input": {
        "unit_type": "ambassador",
        "event": "death"
      },
      "expected": {
        "recovery_turns": 2
      }
    },
    {
      "id": "4.3.2_regular_army_is_combat_unit",
      "rule_ref": "4.3.2",
      "description": "Regular army is a combat unit",
      "input": {
        "unit_type": "regular_army"
      },
      "expected": {
        "is_combat_unit": true
      }
    },
    {
      "id": "4.3.3_regular_army_strength",
      "rule_ref": "4.3.3",
      "description": "Regular army has combat strength of 1",
      "input": {
        "unit_type": "regular_army"
      },
      "expected": {
        "combat_strength": 1
      }
    },
    {
