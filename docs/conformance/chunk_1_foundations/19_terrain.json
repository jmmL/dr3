    {
      "id": "19.11.1_isle_of_fright_cost",
      "rule_ref": "19.11.1",
      "description": "Isle of Fright costs 1 movement point",
      "input": {
        "terrain": "isle_of_fright"
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.11.2_isle_of_fright_restriction",
      "rule_ref": "19.11.2",
      "description": "Fleets may only enter Isle of Fright when effecting rescue",
      "input": {
        "terrain": "isle_of_fright",
        "unit_type": "fleet",
        "is_rescue_operation": false
      },
      "expected": {
        "entry_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "19.12.1_mountain_pass_cost",
      "rule_ref": "19.12.1",
      "description": "Mountain pass costs 2 movement points",
      "input": {
        "terrain": "mountain_pass"
      },
      "expected": {
        "movement_cost": 2
      }
    },
    {
      "id": "19.12.2_mountain_pass_defender_doubled",
      "rule_ref": "19.12.2",
      "description": "Defending units in mountain pass have combat value doubled",
      "input": {
        "terrain": "mountain_pass",
        "combat_role": "defender",
        "base_combat_value": 3
      },
      "expected": {
        "effective_combat_value": 6
      }
    },
    {
      "id": "19.13.1_castle_enemy_forbidden",
      "rule_ref": "19.13.1",
      "description": "Enemy units cannot enter castle hex (see sieges)",
      "input": {
        "terrain": "castle",
