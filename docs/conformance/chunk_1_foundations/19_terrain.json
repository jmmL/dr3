      }
    },
    {
      "id": "19.17.1_cumulative_terrain_rule",
      "rule_ref": "19.17.1",
      "description": "Terrain effects are cumulative",
      "input": {
        "terrain": ["forest", "hills"]
      },
      "expected": {
        "movement_cost": 4
      }
    },
    {
      "id": "19.17.2_forested_mountain_cost",
      "rule_ref": "19.17.2",
      "description": "Forested mountain costs 5 MP (2+3) and requires stop",
      "input": {
        "terrain": ["forest", "mountain"]
      },
      "expected": {
        "movement_cost": 5,
        "must_stop": true
