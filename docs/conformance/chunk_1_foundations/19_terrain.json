        "is_transported": false
      },
      "expected": {
        "entry_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "19.10.1_swamp_cost",
      "rule_ref": "19.10.1",
      "description": "Swamp costs 2 movement points",
      "input": {
        "terrain": "swamp"
      },
      "expected": {
