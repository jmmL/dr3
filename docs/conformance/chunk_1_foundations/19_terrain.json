    {
      "id": "19.9.1_open_sea_cost",
      "rule_ref": "19.9.1",
      "description": "Open sea costs 1 movement point",
      "input": {
        "terrain": "open_sea"
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.9.2_open_sea_fleets_only",
      "rule_ref": "19.9.2",
      "description": "Only fleets may enter open sea (unless transported)",
      "input": {
        "terrain": "open_sea",
