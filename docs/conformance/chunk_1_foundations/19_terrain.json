      }
    },
    {
      "id": "19.14.2_seaport_cost",
      "rule_ref": "19.14.2",
      "description": "Seaport costs 1 movement point",
      "input": {
        "terrain": "seaport"
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.14.3_seaport_access",
      "rule_ref": "19.14.3",
      "description": "Both fleets and land units may access seaports",
      "input": {
        "terrain": "seaport"
      },
      "expected": {
        "fleet_access": true,
