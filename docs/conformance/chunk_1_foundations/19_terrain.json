      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.8.2_fleet_no_all_land_crossing",
      "rule_ref": "19.8.2",
      "description": "Fleets cannot cross all-land hexsides",
      "input": {
        "unit_type": "fleet",
        "hexside_type": "all_land"
      },
      "expected": {
        "crossing_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "19.8.3_land_no_all_sea_crossing",
      "rule_ref": "19.8.3",
      "description": "Land units cannot cross all-sea hexsides",
      "input": {
        "unit_type": "land",
        "hexside_type": "all_sea"
      },
      "expected": {
        "crossing_allowed": false
      },
      "tags": ["negative"]
