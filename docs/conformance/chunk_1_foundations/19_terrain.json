      },
      "expected": {
        "entry_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "19.13.2_castle_friendly_cost",
      "rule_ref": "19.13.2",
      "description": "Friendly castle costs 1 movement point",
      "input": {
        "terrain": "castle",
