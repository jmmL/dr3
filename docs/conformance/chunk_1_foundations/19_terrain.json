{
  "suite_version": "1.0.0",
  "rule_section": "19_terrain",
  "tests": [
    {
      "id": "19.1.1_clear_terrain_cost",
      "rule_ref": "19.1.1",
      "description": "Clear terrain costs 1 movement point",
      "input": {
        "terrain": "clear"
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.2.1_forest_terrain_cost",
      "rule_ref": "19.2.1",
      "description": "Forest terrain costs 2 movement points",
      "input": {
        "terrain": "forest"
      },
      "expected": {
        "movement_cost": 2
      }
    },
    {
      "id": "19.2.2_forest_tree_symbol",
      "rule_ref": "19.2.2",
      "description": "Units with tree symbol treat forest as clear (1 MP)",
      "input": {
        "terrain": "forest",
        "unit_has_tree_symbol": true
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.3.1_minor_river_cost",
      "rule_ref": "19.3.1",
      "description": "Minor river costs 2 movement points",
      "input": {
        "terrain": "minor_river"
      },
      "expected": {
        "movement_cost": 2
      }
    },
    {
      "id": "19.3.2_minor_river_applies_all_directions",
      "rule_ref": "19.3.2",
      "description": "Minor river cost applies when moving into, across, or along",
      "input": {
        "terrain": "minor_river",
        "movement_direction": "into"
      },
      "expected": {
        "movement_cost": 2
      }
    },
    {
      "id": "19.4.1_major_river_crossing_requirement",
      "rule_ref": "19.4.1",
      "description": "Major river crossing requires beginning movement phase in hex",
      "input": {
        "terrain": "major_river",
        "crossing_major_river": true,
        "began_in_hex": false
      },
      "expected": {
        "crossing_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "19.4.2_major_river_crossing_cost",
      "rule_ref": "19.4.2",
      "description": "Major river crossing costs 2 movement points",
      "input": {
        "terrain": "major_river",
        "crossing_major_river": true,
        "began_in_hex": true
      },
      "expected": {
        "movement_cost": 2,
        "crossing_allowed": true
      }
    },
    {
      "id": "19.5.1_hills_terrain_cost",
      "rule_ref": "19.5.1",
      "description": "Hills terrain costs 2 movement points",
      "input": {
        "terrain": "hills"
      },
      "expected": {
        "movement_cost": 2
      }
    },
    {
      "id": "19.5.2_hills_mountain_symbol",
      "rule_ref": "19.5.2",
      "description": "Units with mountain symbol treat hills as clear (1 MP)",
      "input": {
        "terrain": "hills",
        "unit_has_mountain_symbol": true
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.6.1_mountain_terrain_cost",
      "rule_ref": "19.6.1",
      "description": "Mountain terrain costs 3 movement points",
      "input": {
        "terrain": "mountain"
      },
      "expected": {
        "movement_cost": 3
      }
    },
    {
      "id": "19.6.2_mountain_must_stop",
      "rule_ref": "19.6.2",
      "description": "Units must stop after entering mountain hex",
      "input": {
        "terrain": "mountain",
        "unit_has_mountain_symbol": false
      },
      "expected": {
        "must_stop": true
      }
    },
    {
      "id": "19.6.3_mountain_combat_bonus",
      "rule_ref": "19.6.3",
      "description": "Mountains provide +1 to defender's combat die roll",
      "input": {
        "terrain": "mountain",
        "combat_role": "defender"
      },
      "expected": {
        "combat_modifier": 1
      }
    },
    {
      "id": "19.6.4_mountain_symbol_no_stop",
      "rule_ref": "19.6.4",
      "description": "Units with mountain symbol need not stop in mountains but still pay 3 MP",
      "input": {
        "terrain": "mountain",
        "unit_has_mountain_symbol": true
      },
      "expected": {
        "movement_cost": 3,
        "must_stop": false
      }
    },
    {
      "id": "19.7.1_lakeshore_cost",
      "rule_ref": "19.7.1",
      "description": "Lakeshore costs 1 movement point",
      "input": {
        "terrain": "lakeshore"
      },
      "expected": {
        "movement_cost": 1
      }
    },
    {
      "id": "19.7.2_lakeshore_no_crossing",
      "rule_ref": "19.7.2",
      "description": "Land units cannot cross all-lake hexsides",
      "input": {
        "unit_type": "land",
        "hexside_type": "all_lake"
      },
      "expected": {
        "crossing_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "19.8.1_seashore_cost",
