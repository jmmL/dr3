{
  "suite_version": "1.0.0",
  "rule_section": "17_sieges",
  "tests": [
    {
      "id": "17.1.1_castle_must_be_surrounded",
      "rule_ref": "17.1.1",
      "description": "Castle must be surrounded by besieging units or zones of siege",
      "input": {
        "castle_hex": [10, 5],
        "adjacent_hexes_covered": 5,
        "total_adjacent_hexes": 6
      },
      "expected": {
        "siege_allowed": false,
        "reason": "castle_not_surrounded"
      },
      "tags": ["negative"]
    },
    {
      "id": "17.1.1_castle_surrounded_valid",
      "rule_ref": "17.1.1",
      "description": "Castle fully surrounded allows siege declaration",
      "input": {
        "castle_hex": [10, 5],
        "adjacent_hexes_covered": 6,
        "total_adjacent_hexes": 6
      },
      "expected": {
        "surrounding_requirement_met": true
      }
    },
    {
      "id": "17.1.2_no_outside_defenders",
      "rule_ref": "17.1.2",
      "description": "Cannot declare siege if defenders have units outside castle",
      "input": {
        "castle_hex": [10, 5],
        "defending_units_outside": 2
      },
      "expected": {
        "siege_allowed": false,
        "reason": "defenders_outside_castle"
      },
      "tags": ["negative"]
    },
    {
      "id": "17.1.3_sufficient_force_required",
      "rule_ref": "17.1.3",
      "description": "Besieging units must >= defending units + intrinsic defense",
      "input": {
        "besieging_units": 5,
        "intrinsic_defense": 4,
        "units_inside": 2
      },
      "expected": {
        "siege_allowed": false,
        "reason": "insufficient_force",
        "required_minimum": 6
      },
      "tags": ["negative"]
    },
    {
      "id": "17.1.3_minimum_force_exactly_met",
      "rule_ref": "17.1.3",
      "description": "Siege allowed when force exactly equals requirement",
      "input": {
        "besieging_units": 6,
        "intrinsic_defense": 4,
        "units_inside": 2
      },
      "expected": {
        "siege_allowed": true
      },
      "tags": ["boundary"]
    },
    {
      "id": "17.2_different_players_separate_sieges",
      "rule_ref": "17.2",
      "description": "Different players may not combine strengths; must conduct separate sieges",
      "input": {
        "player_a_units": 4,
        "player_b_units": 4,
        "castle_defense": 5
      },
      "expected": {
        "combined_siege_allowed": false,
        "separate_sieges_possible": true
      },
      "tags": ["negative"]
    },
    {
      "id": "17.3.1_zone_of_siege_extends_one_hex",
      "rule_ref": "17.3.1",
      "description": "Zone of siege extends one hex around castle in either direction from adjacent unit",
      "input": {
        "unit_hex": [10, 4],
        "castle_hex": [10, 5],
        "unit_type": "army"
      },
      "expected": {
        "zone_of_siege_hexes": [[9, 4], [11, 4]]
      }
    },
    {
      "id": "17.3.2_fleet_zone_sea_only",
      "rule_ref": "17.3.2",
      "description": "Fleet zone of siege only extends to all-sea or seashore hexes",
      "input": {
        "unit_hex": [10, 4],
        "unit_type": "fleet",
        "adjacent_terrain": ["all_sea", "seashore", "all_land"]
      },
      "expected": {
        "zone_extends_to": ["all_sea", "seashore"],
        "zone_excludes": ["all_land"]
      }
    },
    {
      "id": "17.3.3_land_unit_zone_land_only",
      "rule_ref": "17.3.3",
      "description": "Land unit zone of siege only extends to all-land and seashore hexes",
      "input": {
        "unit_hex": [10, 4],
        "unit_type": "army",
        "adjacent_terrain": ["all_sea", "seashore", "all_land"]
      },
      "expected": {
        "zone_extends_to": ["all_land", "seashore"],
        "zone_excludes": ["all_sea"]
      }
    },
    {
      "id": "17.3.4_friendly_units_no_negate_zone",
      "rule_ref": "17.3.4",
      "description": "Friendly units to besieged castle do not negate zones of siege",
      "input": {
        "zone_of_siege_hex": [11, 5],
        "friendly_unit_in_zone": true
      },
      "expected": {
        "zone_negated": false
      }
    },
    {
      "id": "17.4.1_track_units_inside_inverted",
      "rule_ref": "17.4.1",
      "description": "Units inside castle are tracked by inverting counters",
      "input": {
        "units_inside_castle": ["u1", "u2"]
      },
      "expected": {
        "counter_state": "inverted"
      }
    },
    {
      "id": "17.4.2_outside_units_must_be_cleared",
      "rule_ref": "17.4.2",
      "description": "Outside defending units must be eliminated or retreated before siege",
      "input": {
        "outside_defenders_present": true,
        "attempt_siege_declaration": true
      },
      "expected": {
        "siege_declaration_valid": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.4.4_retreat_into_castle",
      "rule_ref": "17.4.4",
      "description": "Units may retreat before combat into castle",
      "input": {
        "unit_location": "outside_castle",
        "retreat_destination": "inside_castle",
        "castle_friendly": true
      },
      "expected": {
        "retreat_allowed": true
      }
    },
    {
      "id": "17.4.5_leader_inside_no_bonus_outside",
      "rule_ref": "17.4.5",
      "description": "Leader inside castle cannot add combat bonus to units outside",
      "input": {
        "leader_location": "inside_castle",
        "units_outside": ["u1", "u2"]
      },
      "expected": {
        "leader_combat_bonus_applies": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.4.6_no_movement_cost_castle_entry",
      "rule_ref": "17.4.6",
      "description": "No movement cost to move in or out of castle",
      "input": {
        "movement_type": "enter_castle"
      },
      "expected": {
        "movement_cost": 0
      }
    },
    {
      "id": "17.5.1_intrinsic_defense_on_counter",
      "rule_ref": "17.5.1",
      "description": "Intrinsic defense strength is number on castle hex",
      "input": {
        "castle_hex": [10, 5],
        "printed_defense": 4
      },
      "expected": {
        "intrinsic_defense_strength": 4
      }
    },
    {
      "id": "17.5.2_intrinsic_defense_only",
      "rule_ref": "17.5.2",
      "description": "Intrinsic defense applies only to defense, cannot attack",
      "input": {
        "intrinsic_defense": 4,
        "action": "attack"
      },
      "expected": {
        "intrinsic_strength_applies": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.5.3_intact_castle_blocks_entry",
      "rule_ref": "17.5.3",
      "description": "Enemy units cannot enter intact castle (except ambassadors)",
      "input": {
        "castle_status": "intact",
        "entering_unit": "enemy_army"
      },
      "expected": {
        "entry_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.5.3_ambassador_may_enter_castle",
      "rule_ref": "17.5.3",
      "description": "Ambassadors may enter enemy castle",
      "input": {
        "castle_status": "intact",
        "entering_unit": "ambassador"
      },
      "expected": {
        "entry_allowed": true
      }
    },
    {
      "id": "17.5.4_plundered_castle_no_defense",
      "rule_ref": "17.5.4",
      "description": "Plundered castle loses defense strength",
      "input": {
        "castle_status": "plundered",
        "original_defense": 4
      },
      "expected": {
        "intrinsic_defense_strength": 0
      }
    },
    {
      "id": "17.6.1_siege_declared_instantly",
      "rule_ref": "17.6.1",
      "description": "Siege is declared instant three conditions are met",
      "input": {
        "surrounded": true,
        "no_outside_defenders": true,
        "sufficient_force": true
      },
      "expected": {
        "siege_declaration": "instant"
      }
    },
    {
      "id": "17.6.2_any_player_may_declare",
      "rule_ref": "17.6.2",
      "description": "Any player may declare that siege conditions are met",
      "input": {
        "declaring_player": "observer",
        "conditions_met": true
      },
      "expected": {
        "declaration_valid": true
      }
    },
    {
      "id": "17.6.3_retreated_units_not_besieging",
      "rule_ref": "17.6.3",
      "description": "Units that retreated before combat cannot count as besieging until next movement phase",
      "input": {
        "unit_retreated_before_combat": true,
        "current_phase": "siege_resolution"
      },
      "expected": {
        "counts_as_besieging": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.7.1_reinforcements_blocked",
      "rule_ref": "17.7.1",
      "description": "Reinforcements cannot enter besieged castle",
      "input": {
        "castle_status": "besieged",
        "reinforcement_attempt": true
      },
      "expected": {
        "entry_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.7.2_leaving_must_attack_first",
      "rule_ref": "17.7.2",
      "description": "Units leaving siege must attack all besieging units first",
      "input": {
        "besieged_units_leaving": true,
        "attack_besiegers": false
      },
      "expected": {
        "exit_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.7.2_exit_after_attack",
      "rule_ref": "17.7.2",
      "description": "Win or lose, survivors may move out through zone of siege after attack",
      "input": {
        "attacked_besiegers": true,
        "combat_result": "loss",
        "survivors": 2
      },
      "expected": {
        "exit_allowed": true,
        "movement_allowance": "full"
      }
    },
    {
      "id": "17.7.3_attack_from_siege_alternative",
      "rule_ref": "17.7.3",
      "description": "Besieged may attack during combat phase instead of siege-resolution",
      "input": {
        "attack_timing": "combat_phase",
        "besieged_units_attacking": true
      },
      "expected": {
        "attack_allowed": true
      }
    },
    {
      "id": "17.7.3_advance_limit_one_hex",
      "rule_ref": "17.7.3",
      "description": "Advance limited to one hex if all units in defender hex eliminated",
      "input": {
        "attacking_from_siege": true,
        "defender_hex_cleared": true
      },
      "expected": {
        "advance_limit_hexes": 1
      }
    },
    {
      "id": "17.8.1_resolution_timing",
      "rule_ref": "17.8.1",
      "description": "Siege resolved during besieging player's siege resolution phase",
      "input": {
        "current_phase": "siege_resolution",
        "active_player": "besieger"
      },
      "expected": {
        "resolution_allowed": true
      }
    },
    {
      "id": "17.8.2_siege_roll_procedure",
      "rule_ref": "17.8.2",
      "description": "Siege resolution uses 1d6 roll",
      "input": {
        "siege_resolution_initiated": true
      },
      "expected": {
        "die_type": "d6",
        "dice_count": 1
      }
    },
    {
      "id": "17.8.3_roll_one_to_five_continues",
      "rule_ref": "17.8.3",
      "description": "Rolls 1-5 result in siege continuing",
      "input": {
        "siege_roll": 5,
        "siege_modifier": 0
      },
      "expected": {
        "modified_roll": 5,
        "castle_taken": false,
        "siege_continues": true
      }
    },
    {
      "id": "17.8.4_roll_six_castle_taken",
      "rule_ref": "17.8.4",
      "description": "Roll of 6+ takes castle",
      "input": {
        "siege_roll": 6,
        "siege_modifier": 0
      },
      "expected": {
        "modified_roll": 6,
        "castle_taken": true,
        "units_inside_eliminated": true,
        "leaders_require_fate_roll": true
      }
    },
    {
      "id": "17.8.4_modified_six_castle_taken",
      "rule_ref": "17.8.4",
      "description": "Modified roll of 6 takes castle",
      "input": {
        "siege_roll": 5,
        "siege_modifier": 1
      },
      "expected": {
        "modified_roll": 6,
        "castle_taken": true
      }
    },
    {
      "id": "17.8.5_siege_attackers_no_further_action",
      "rule_ref": "17.8.5",
      "description": "Units making siege attack cannot otherwise move or attack",
      "input": {
        "unit_made_siege_attack": true
      },
      "expected": {
        "further_movement_allowed": false,
        "further_attack_allowed": false
      },
      "tags": ["negative"]
    },
    {
      "id": "17.9.1_siege_modifier_formula",
      "rule_ref": "17.9.1",
      "description": "Siege modifier = (attackers / (defenders + defense)) - 1",
      "input": {
        "besieging_units": 15,
        "intrinsic_defense": 4,
        "units_inside": 3
      },
      "expected": {
        "modifier": 1
      },
      "notes": "15 / (3 + 4) = 15/7 = 2.14, drop fraction = 2, subtract 1 = +1"
    },
    {
      "id": "17.9.2_siege_modifier_fractions_dropped",
      "rule_ref": "17.9.2",
      "description": "Fractions are dropped in siege modifier calculation",
      "input": {
        "besieging_units": 15,
        "intrinsic_defense": 4,
        "units_inside": 4
      },
      "expected": {
        "modifier": 0
      },
      "notes": "15 / 8 = 1.875, drop to 1, subtract 1 = 0"
    },
    {
      "id": "17.9.3_siege_modifier_high",
      "rule_ref": "17.9.3",
      "description": "High attacker ratio gives +2 modifier",
      "input": {
        "besieging_units": 15,
        "intrinsic_defense": 4,
        "units_inside": 1
      },
      "expected": {
        "modifier": 2
      },
      "notes": "15 / 5 = 3, subtract 1 = +2"
    },
    {
      "id": "17.10.1_plundered_castle_nonexistent",
      "rule_ref": "17.10.1",
      "description": "Plundered castle treated as nonexistent for siege/combat",
      "input": {
        "castle_status": "plundered"
      },
      "expected": {
        "siege_rules_apply": false,
        "castle_defense_applies": false
      }
    },
    {
      "id": "17.10.2_plundered_retains_placement",
      "rule_ref": "17.10.2",
      "description": "Plundered castle retains function as placement hex",
      "input": {
        "castle_status": "plundered",
        "unit_type": "regular"
      },
      "expected": {
        "placement_allowed": true
      }
    },
    {
      "id": "17.10.4_occupation_makes_friendly",
      "rule_ref": "17.10.4",
      "description": "Occupying plundered castle makes it friendly for mercenary deployment",
      "input": {
        "castle_status": "plundered",
        "occupied_by": "player_units"
      },
      "expected": {
        "friendly_for_deployment": true
      }
    },
    {
      "id": "17.10.5_plunder_permanent",
      "rule_ref": "17.10.5",
      "description": "Plundered status is permanent",
      "input": {
        "castle_status": "plundered",
        "turns_passed": 10
      },
      "expected": {
        "status_changed": false,
        "still_plundered": true
      }
    },
    {
      "id": "17.11.1_fleets_contribute_siege",
