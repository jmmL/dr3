{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refs_derived/abilities.schema.json",
  "type": "object",
  "required": ["version", "generated_at", "abilities"],
  "properties": {
    "version": {"type": "string"},
    "generated_at": {"type": "string"},
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "rule_refs"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "rule_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
