{
  "name": "dr3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ios": "playwright test --project=ios-safari",
    "test:e2e:board:contract": "playwright test src/test/e2e/board.contract.spec.ts --project=chromium --project=ios-safari",
    "test:e2e:board:visual": "playwright test src/test/e2e/board.visual.spec.ts --project=chromium --project=ios-safari",
    "test:e2e:board:visual:update": "playwright test src/test/e2e/board.visual.spec.ts --project=chromium --project=ios-safari --update-snapshots",
    "test:e2e:board:loop": "playwright test src/test/e2e/board.contract.spec.ts --project=chromium --repeat-each=5",
    "test:local:gate": "npm run lint && npm test && npm run build && npm run test:e2e:board:contract && npm run test:e2e:board:visual",
    "mcp:playwright": "npx -y @playwright/mcp@latest"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@koa/cors": "^5.0.0",
    "cookie": "^0.7.2",
    "engine.io": "^6.6.5",
    "socket.io": "^4.8.3",
    "socket.io-parser": "^4.2.5",
    "svelte": "^4.2.19",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
